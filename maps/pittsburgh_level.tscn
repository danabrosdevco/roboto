[node name="RelayDam" parent="." node_paths=PackedStringArray("linked_squad_point") instance=ExtResource("pitt_capture")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -298, -1.21, -161)
channel_duration = 5.0
id = &"pitt_relay_dam"
display_name = "Lock Relay"
description = "In the lock-keeper's post on the west bank of the Ohio dam: five seconds at the console. The dam garrison calls its gunships in over the north ridge the moment you engage it, and the lock-keepers come back down the river for the relay once it is yours."
reward_resources = 40
linked_squad_point = NodePath("../EnemySquadObjs/Pitt_Dam")

[node name="RelayShore" parent="." node_paths=PackedStringArray("linked_squad_point") instance=ExtResource("pitt_capture")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -155, -0.83, -45)
channel_duration = 5.0
id = &"pitt_relay_shore"
display_name = "North Shore Relay"
description = "In the command post on the north shore. A fight here brings bombers in over the plateau to the south, and taking the relay brings their reserve across the bridges from the south bank."
reward_resources = 40
linked_squad_point = NodePath("../EnemySquadObjs/Pitt_Shore")

[node name="RelayStrip" parent="." node_paths=PackedStringArray("linked_squad_point") instance=ExtResource("pitt_capture")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 100, 0.58, -85)
channel_duration = 5.0
id = &"pitt_relay_strip"
display_name = "Strip Relay"
description = "Behind the bunker on the Strip, up the Allegheny from the Point. Its garrison has air on call from the north-east hills, and armour comes down off the plateau when the relay falls."
reward_resources = 40
linked_squad_point = NodePath("../EnemySquadObjs/Pitt_Strip")

[node name="RelayFurnace" parent="." node_paths=PackedStringArray("linked_squad_point") instance=ExtResource("pitt_capture")]
