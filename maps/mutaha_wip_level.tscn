[node name="RelayGate" parent="." node_paths=PackedStringArray("linked_squad_point") instance=ExtResource("mut_capture")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -18, -1.1, 150)
channel_duration = 6.0
id = &"mutaha_relay_gate"
display_name = "Gatehouse Relay"
description = "Behind the wall on the island's south tip, where the road to the dropped bridge dies. Six seconds at it. There is one way in and it is the gate."
reward_resources = 45
linked_squad_point = NodePath("../EnemySquadObjs/Mutaha_Gate")

[node name="RelayServer" parent="." node_paths=PackedStringArray("linked_squad_point") instance=ExtResource("mut_capture")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -24, -0.95, -53)
channel_duration = 8.0
id = &"mutaha_relay_server"
display_name = "Server Garden"
description = "Nine rack rows in the open, half of them toppled, in the middle of the island. Eight seconds at the console with a marksman on every roof line that looks onto it."
reward_resources = 55
linked_squad_point = NodePath("../EnemySquadObjs/Mutaha_Server")

[node name="RelayCompute" parent="." node_paths=PackedStringArray("linked_squad_point") instance=ExtResource("mut_capture")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -7, -0.99, -86)
channel_duration = 15.0
id = &"mutaha_relay_compute"
display_name = "Compute Hall"
description = "The data hall itself, and the reason anybody is fighting over this city. Fifteen seconds at the console — long enough for both banks to come back over the bridges, for the hall's own armour to work around you, and for whatever is dug in on the avenue to range in on the courtyard. Do not start this one until you have somewhere to stand."
reward_resources = 110
linked_squad_point = NodePath("../EnemySquadObjs/Mutaha_Compute")

[node name="RelayClock" parent="." node_paths=PackedStringArray("linked_squad_point") instance=ExtResource("mut_capture")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -238, 0.11, -217)
channel_duration = 8.0
id = &"mutaha_relay_clock"
display_name = "Clock Square"
description = "Across the west bridge, under the tower. The square is held in strength and the streets around it are theirs; the relay is in the open at the foot of the clock."
reward_resources = 70
linked_squad_point = NodePath("../EnemySquadObjs/Mutaha_Clock")

