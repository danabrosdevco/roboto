channel_duration = 10.0
id = &"cway_relay_basement"
display_name = "The Basement Hall"
description = "Down the pit, sixty metres at one in six on the far side of the yard from the gate, and in through the portal. The hall is forty-one metres square and empty — no racks, no plant, nothing to stand behind. Ten seconds, and it is the quietest the tower ever gets."
reward_resources = 160
linked_squad_point = NodePath("../Posts/CW_Hall00Far")

[node name="RelayTwelfth" parent="." node_paths=PackedStringArray("linked_squad_point") instance=ExtResource("6_capture")]
