; ── THE OBJECTIVES ───────────────────────────
; Seven captures and a pad, in the order the ground takes them, and the channel
; is the clock: six seconds on the west bank, twenty-four at the top of the
; tower. Each one is also the trigger for what answers it — a reserve's
; reinforcement_tag IS an objective id.
;
; ── CORE SIZES, AND WHY THE BIGGEST FIGHT HAS THE SMALLEST CORE ──
; Measured collision, not the heights in docs/BLOCKS.md:
;   small   1.88 x 1.88,  4.19 m tall
;   medium  3.38 x 3.38,  6.97 m tall
;   large   5.19 x 5.19, 12.38 m tall
;
; THE TOWER CANNOT TAKE ANYTHING BUT SMALL. Floors are 6 m apart and each plate
; is 0.75 thick, so a data hall has about 5.25 m of clear height — a medium
; core is 6.97 and would come up through the floor above it. That settles the
; basement, the twelfth and the CROWN UPLINK, which is the last objective in
; the campaign and gets the smallest core on the map because the room it stands
; in says so. The fort yard is where the big one goes: 200 m square, open sky.
;
; Each core is also YAWED so its service alcove — the prefab's -X, and the one
; spot a body can stand while it channels — faces the way the squad arrives.
; docs/BLOCKS.md asks for this and no map in the project had done it. The
; tower's arrival side rotates with the floor, which is why the basement opens
; EAST (the portal is in the +x face) and the top hall opens NORTH (its
; stairwell comes up on the -z side).

[node name="RelayStaging" parent="." node_paths=PackedStringArray("linked_squad_point") instance=ExtResource("6_capture")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -350, 1, 30)
channel_duration = 6.0
id = &"cway_relay_staging"
display_name = "The Staging Yard"
description = "The last hardstanding before the ramp, where the old highway ran out. Six seconds. Finish it and the picket on the deck knows somebody is coming across."
reward_resources = 60
linked_squad_point = NodePath("../Posts/CW_Staging")

; MID-CAUSEWAY, AND THIS IS THE SIGNATURE MOMENT OF THE MAP. Ten seconds
; standing still in the middle of six hundred metres of open deck, three
; hundred from either bank, with the two shelled spans behind and ahead of you
; and nothing within reach but a one-metre parapet.
;
; On a SOUND span, deliberately: the core is 4.2 m across and the breach lanes
; are 7 m, so putting it on one of those would wall the crossing off entirely.
[node name="RelayCrossing" parent="." node_paths=PackedStringArray("linked_squad_point") instance=ExtResource("6_capture")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 12, 5, 0)
channel_duration = 10.0
id = &"cway_relay_crossing"
display_name = "Mid Causeway"
description = "Halfway. Ten seconds in the open on a sixteen-metre deck with a one-metre parapet, three hundred metres from either bank, and the only cover is whichever side of the span you are not being shot from. Do not start it with a breach still held behind you."
reward_resources = 110
linked_squad_point = NodePath("../Posts/CW_DeckMid")

[node name="RelayCheckpoint" parent="." node_paths=PackedStringArray("linked_squad_point") instance=ExtResource("10_capture_mid")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 352, 1, 58)
channel_duration = 12.0
id = &"cway_relay_checkpoint"
display_name = "The Checkpoint"
description = "Off the east ramp and into the wire. Twelve seconds at the checkpoint hut with the dragon's teeth on one side, two sangars and two sentry turrets on the other, and the fort's own wall looking down the whole glacis."
reward_resources = 140
linked_squad_point = NodePath("../Posts/CW_Checkpoint")

[node name="RelayYard" parent="." node_paths=PackedStringArray("linked_squad_point") instance=ExtResource("11_capture_big")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 470, 10, 0)
channel_duration = 14.0
id = &"cway_relay_yard"
display_name = "The West Yard"
description = "Inside the gate, and the gate is the only way in — the curtain wall is eight metres thick from the ground to a walk four metres above the yard, and there is no other opening in it. Fourteen seconds standing in a two-hundred-metre square courtyard with a walk round all four sides of it and a bastion at every corner."
reward_resources = 190
linked_squad_point = NodePath("../Posts/CW_YardWest")

[node name="RelayBasement" parent="." node_paths=PackedStringArray("linked_squad_point") instance=ExtResource("6_capture")]
