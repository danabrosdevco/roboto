display_name = "The Crown Uplink"
description = "The top hall, a hundred and thirty-eight metres up, twenty-four floors above the pit. Twenty-four seconds — the longest channel in the game — with everything still alive in the shaft below you climbing toward it and nowhere left to fall back to. The pad is at the other end of the room."
reward_resources = 420
compute_reward = 2
linked_squad_point = NodePath("../Posts/CW_Hall23")

