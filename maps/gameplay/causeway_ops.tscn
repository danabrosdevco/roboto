display_name = "The Twelfth Hall"
description = "Seventy-two metres up, at the first set-back, which is the halfway mark of the climb. Sixteen seconds between the rack rows. Finishing it is what wakes everything above you — the upper halls are held and they come down to meet you rather than waiting to be found."
reward_resources = 240
compute_reward = 1
linked_squad_point = NodePath("../Posts/CW_Hall12")

[node name="RelayUplink" parent="." node_paths=PackedStringArray("linked_squad_point") instance=ExtResource("6_capture")]
