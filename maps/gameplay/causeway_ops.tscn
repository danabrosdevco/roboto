[node name="CausewayOps" type="Node3D"]

; NO MissionStart IN HERE, unlike the other two ops layers. The causeway level
; is hand-built and is not regenerated, so its own PlayerSpawn is safe and is
; already in the right place — the west bank at (-500, 1.24, 30), the end of the
; old highway. The root's `spawn_point` keeps pointing at it and
; tools/mission_ops.sh does not touch this level's root at all.
;
; One thing about it DID have to change: it was authored at identity, which
; faces -Z, and the causeway runs east. The first thing on screen was the empty
; north shore rather than the crossing. It is yawed -90 in the level file now.
[node name="SquadSpawnPoint" type="Node3D" parent="."]
transform = Transform3D(0, 0, 1, 0, 1, 0, -1, 0, 0, -506, 1.24, 24)
script = ExtResource("2_squad")
max_slots = 999

