[node name="GeorgetownOps" type="Node3D"]

; WHERE YOU COME IN. The west end of the park, on the lowest bench, facing
; east down the two path spines — so the first thing on screen is the length
; of the waterfront and the stack standing over the far end of it.
;
; NOT the SpawnPoint build_georgetown.gd writes, which stands in the UPPER
; TOWN: that is the top of the climb and the end of this operation. Theirs is
; left alone for pressing F5 on the map; the level's `spawn_point` export is
; pointed at this one by tools/mission_ops.sh.
[node name="MissionStart" parent="." instance=ExtResource("1_spawn")]
transform = Transform3D(0, 0, 1, 0, 1, 0, -1, 0, 0, -200, -8, 152)

; No cap. Every hand-built level in this project writes 999 over the export's
; own default, and the one that did not deployed four robots out of a
; seven-seat squad with nothing to say about it.
[node name="SquadSpawnPoint" type="Node3D" parent="."]
transform = Transform3D(0, 0, 1, 0, 1, 0, -1, 0, 0, -196, -8, 144)
script = ExtResource("2_squad")
max_slots = 999

