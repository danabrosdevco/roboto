; ── THE OBJECTIVES ───────────────────────────
; ONE RELAY PER BENCH, in the order the climb takes them, and the channel gets
; longer as you go up: 6 seconds in the park, 14 on the street. A long channel
; is the mission asking for ground to be HELD rather than reached, and holding
; the top of a terraced town is a harder promise than holding a corner of a
; derelict park — so the number says which.
;
; Every one of these is also a reserve trigger: a mission's reinforcement_tag
; IS an objective id, so finishing a relay is what calls the next column in.
;
; ── TWO THINGS ABOUT THE CORES THEMSELVES ────
;
; 1. THE SIZE SAYS WHAT THE OBJECTIVE IS WORTH, and it is chosen against the
;    ground rather than the importance. Measured collision footprints:
;      small   1.88 x 1.88,  4.19 m tall
;      medium  3.38 x 3.38,  6.97 m tall
;      large   5.19 x 5.19, 12.38 m tall
;    These go in AFTER the navmesh is baked, so the baker knows nothing about
;    them and the squad paths straight at one. On open ground that is a body
;    sliding round a post; in a lane barely wider than the core it is a squad
;    stuck in a doorway. So: large only where there is twenty metres of open
;    ground round it, medium at twelve, small otherwise.
;
; 2. THE ALCOVE FACES THE PREFAB'S -X, and it is the one spot a body can stand
;    while it channels — docs/BLOCKS.md asks for these to be yawed to face the
;    approach "the way the relay dish is yawed", and no map in the project had
;    done it. Every core below is turned to face the direction the squad
;    arrives from. yaw 0 opens west, 90 opens south, 180 east, -90 north.

[node name="RelayPark" parent="." node_paths=PackedStringArray("linked_squad_point") instance=ExtResource("6_capture")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -34, -8, 132)
channel_duration = 6.0
id = &"gt_relay_park"
display_name = "The Bandstand"
description = "Under the bandstand roof in the middle of the derelict park, with the beds and the hedges round it and nothing above it but the terrace wall. Six seconds. It is the easiest of the four and it is the one that tells them you are here."
reward_resources = 50
linked_squad_point = NodePath("../Posts/GT_Bandstand")

[node name="RelayStack" parent="." node_paths=PackedStringArray("linked_squad_point") instance=ExtResource("10_capture_mid")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 86, -4, 112)
channel_duration = 9.0
id = &"gt_relay_stack"
display_name = "The Stack"
description = "At the foot of the forty-four metre chimney on the yards bench — the one thing on this map you can see from every level of it, which cuts both ways. Nine seconds in the open, with the stair heads either side of you and a viaduct at each end of the bench looking down the length of it."
reward_resources = 80
linked_squad_point = NodePath("../Posts/GT_Stack")

[node name="RelayLock" parent="." node_paths=PackedStringArray("linked_squad_point") instance=ExtResource("10_capture_mid")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 48, 0, -9)
channel_duration = 12.0
id = &"gt_relay_lock"
display_name = "The Lock"
description = "On the lock coping beside the gates, which are the only dry crossing of the canal that is not a bridge somebody is holding. Twelve seconds standing over a nine-metre slot with towpaths both sides and a mechanic in the lock yard standing their armour back up as fast as you knock it down."
reward_resources = 110
linked_squad_point = NodePath("../Posts/GT_Lock")

[node name="RelayStreet" parent="." node_paths=PackedStringArray("linked_squad_point") instance=ExtResource("11_capture_big")]
transform = Transform3D(0, 0, -1, 0, 1, 0, 1, 0, 0, -40, 4, -108)
channel_duration = 14.0
id = &"gt_relay_street"
display_name = "Water Street"
description = "Top bench, in the open between the carriageway and the north pavement, with a brick terrace twenty metres away on both sides and marksmen behind the north one. Fourteen seconds — long enough for everything still alive below you to come up the ramp, and long enough for the column on the upper road to arrive. Do not start it until you own a doorway."
reward_resources = 160
compute_reward = 1
linked_squad_point = NodePath("../Posts/GT_Street")

; ── OPTIONAL ─────────────────────────────────
; All four of these sit OFF the climb, which is what makes them a choice: each
; one costs a detour along a bench you would otherwise cross, and each one
; takes something away from the fight above it.

[node name="RelayMill" parent="." node_paths=PackedStringArray("linked_squad_point") instance=ExtResource("6_capture")]
transform = Transform3D(-1, 0, 0, 0, 1, 0, 0, 0, -1, -212, 0, -6)
channel_duration = 8.0
id = &"gt_relay_mill"
display_name = "The Long Mill"
description = "The far west end of the mill row, two hundred metres off the line of the climb. Nobody makes you go. Eight seconds at it, and the pay is the best on the map for a relay this size."
optional = true
reward_resources = 120
linked_squad_point = NodePath("../Posts/GT_Mill")

; A nest is a squad of one, so the callsign IS the target set. No zone: a
; volume round the works compound would also count everything the nest is busy
; hatching and would have to be drawn to fit a garrison it knows nothing about.
[node name="HiveYards" type="Node3D" parent="." node_paths=PackedStringArray("linked_squad_point")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, -4, 86)
script = ExtResource("7_eliminate")
squad_callsigns = Array[StringName]([&"GLUTTON"])
id = &"gt_hive_yards"
display_name = "The Yard Hive"
description = "Inside the works compound in the middle of the yards. Leave it and it feeds chasers up the stairs behind you for as long as the operation lasts."
optional = true
reward_resources = 70
linked_squad_point = NodePath("../Posts/GT_Compound")

[node name="HiveTown" type="Node3D" parent="." node_paths=PackedStringArray("linked_squad_point")]
