; ── THE WAY OUT ──────────────────────────────
; The east end of the upper street, which is the far corner of the map from
; the landing. requires_objectives_complete on the exit as well as the
; prerequisites on the objective: the pad is not a way home until the climb is
; finished, and a player standing on an inert pad with no reason given is a
; player who thinks the mission is broken.
[node name="LevelExit" parent="." instance=ExtResource("9_exit")]
transform = Transform3D(4, 0, 0, 0, 4, 0, 0, 0, 4, 200, 4, -96)
requires_objectives_complete = true

