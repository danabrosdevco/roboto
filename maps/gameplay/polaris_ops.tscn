squad_callsigns = Array[StringName]([&"PROJECTION"])
id = &"pol_cinema"
display_name = "The Multiplex"
description = "Four marksmen dug in along the multiplex frontage. It is the only hard cover inside the loop on that side and there is ninety metres of open asphalt between it and the court, which is the whole problem: they can see you crossing and you cannot get at them without crossing. There from the first minute, and they stay."
optional = true
reward_resources = 80
linked_squad_point = NodePath("../Posts/POL_Cinema")

