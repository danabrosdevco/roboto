description = "The deck garrison, in and around the structure at the east end of the aisles. Same job as the multiplex on the other side and the same hundred metres of open ground in front of it. The deck itself is sealed — there is no way up onto it — so this is a fight at its feet."
optional = true
reward_resources = 80
linked_squad_point = NodePath("../Posts/POL_Garage")

[node name="StorageHive" type="Node3D" parent="." node_paths=PackedStringArray("linked_squad_point")]
