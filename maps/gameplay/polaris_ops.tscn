; ── THE ROUTES ───────────────────────────────
[node name="Routes" type="Node" parent="."]

; THE ONE GENUINE CIRCUIT IN THE PROJECT, and the only route here with
; ping_pong OFF. The ring road is a closed loop, so a squad walking it should
; come back round rather than turn and retrace — which is also the thing that
; makes a patrol on it dangerous: it arrives from a different side each time.
[node name="PatrolRing" parent="Routes" node_paths=PackedStringArray("points") instance=ExtResource("4_route")]
tag = &"patrol_pol_ring"
points = [NodePath("P1"), NodePath("P2"), NodePath("P3"), NodePath("P4")]
ping_pong = false
arrow_size = 2.0

[node name="P1" parent="Routes/PatrolRing" instance=ExtResource("5_point")]
