; ── THE OBJECTIVES ───────────────────────────
; One capture that starts everything, five waves, one way out, and three
; optional targets that are all "take away a place they are shooting you from".

; THE BIGGEST CORE IN THE PROJECT, and this is the place for it: 12.4 m
; standing in the open in front of the mall doors with four hundred metres of
; car park in front of it, which makes it the thing you steer by from the
; frontage and the thing every wave converges on. Its 5.19 m footprint goes in
; AFTER the navmesh is baked, so it wants open ground round it — the court has
; it in every direction but north, where the mall is.
;
; Yawed 90 so the service alcove — the prefab's -X, and the only spot a body
; can stand while it channels — opens SOUTH, back down the car park you crossed
; to get here, instead of into the mall wall.
[node name="Breach" parent="." node_paths=PackedStringArray("linked_squad_point") instance=ExtResource("11_capture_big")]
transform = Transform3D(0, 0, -1, 0, 1, 0, 1, 0, 0, 0, 0, 56)
channel_duration = 6.0
id = &"pol_breach"
display_name = "The Court Uplink"
description = "In the open in front of the mall doors, where the valet canopy used to be. Six seconds to open the drain. It is the shortest channel in the operation and it is the one that calls everything on this site down on you — once it is running you do not get to leave until the drain is finished."
reward_resources = 60
linked_squad_point = NodePath("../Posts/POL_Court")

; EACH WAVE IS AN ELIMINATE ON THE CALLSIGNS THAT ARRIVE WITH IT, not a zone.
; A zone round the court would also count the garrison already standing in it
; and every later wave that walked into the volume, so the count would never
; settle. A callsign list is exactly "these ones".
;
; starts_active = false with the previous wave as prerequisite: see the header.
[node name="Wave1" type="Node3D" parent="." node_paths=PackedStringArray("linked_squad_point", "prerequisites")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0, 96)
script = ExtResource("7_eliminate")
squad_callsigns = Array[StringName]([&"SLEET", &"HAIL", &"RIME"])
required_kills = 12
id = &"pol_wave_1"
display_name = "The First Push"
description = "Up the car park from the frontage you just walked in over, so your way back is the first thing they take. Infantry and chasers, nothing armoured."
reward_resources = 70
starts_active = false
prerequisites = [NodePath("../Breach")]
linked_squad_point = NodePath("../Posts/POL_Signs")

[node name="Wave2" type="Node3D" parent="." node_paths=PackedStringArray("linked_squad_point", "prerequisites")]
