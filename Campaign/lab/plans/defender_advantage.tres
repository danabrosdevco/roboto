[resource]
script = ExtResource("1_plan")
title = "Defender advantage"
question = "Does digging in on a post beat attacking it, and by how much? The control row fights the same squads on open ground. The attacker-count rows find how many it takes to break four defenders half the time."
matchups = Array[Resource]([SubResource("M1"), SubResource("M2"), SubResource("M3"), SubResource("M4"), SubResource("M5"), SubResource("M6"), SubResource("M7")])
repeats_override = 0
speed = 2.0
