[resource]
script = ExtResource("1_plan")
title = "Mixed squads"
question = "Does a melee screen protect the guns behind it, or just die first? Each mixed squad fights four rifles; compare against the pure squads in Melee scaling."
matchups = Array[Resource]([SubResource("M1"), SubResource("M2"), SubResource("M3"), SubResource("M4")])
repeats_override = 0
speed = 2.0
