[sub_resource type="Resource" id="M1"]
script = ExtResource("2_match")
label = "2 chasers + 2 rifles vs 4 rifles"
allies = Array[ExtResource("3_chassis")]([ExtResource("4_chaser"), ExtResource("4_chaser"), ExtResource("6_rifle"), ExtResource("6_rifle")])
ally_order = 1
hostiles = Array[ExtResource("3_chassis")]([ExtResource("6_rifle"), ExtResource("6_rifle"), ExtResource("6_rifle"), ExtResource("6_rifle")])
hostile_order = 1
distance = 25.0
repeats = 6
time_limit = 120.0
swap_sides = true
hostiles_on_post = false

