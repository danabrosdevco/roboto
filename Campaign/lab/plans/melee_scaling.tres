[resource]
script = ExtResource("1_plan")
title = "Melee scaling"
question = "Chasers and hoppers win one-on-one against guns. At what numbers does firepower take over? The EQUAL HP rows put the same total health on each side (two chasers or two hoppers weigh about one rifleman), so a win there is the chassis, not the headcount."
matchups = Array[Resource]([SubResource("M1"), SubResource("M2"), SubResource("M3"), SubResource("M4"), SubResource("M5"), SubResource("M6"), SubResource("M7"), SubResource("M8"), SubResource("M9"), SubResource("M10")])
repeats_override = 0
speed = 2.0
