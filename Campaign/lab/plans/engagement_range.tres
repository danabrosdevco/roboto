[resource]
script = ExtResource("1_plan")
title = "Engagement range"
question = "Does the starting distance decide melee against guns? Melee should win up close and lose in the open. If it wins at every range, closing speed or damage is too high."
matchups = Array[Resource]([SubResource("M1"), SubResource("M2"), SubResource("M3"), SubResource("M4"), SubResource("M5"), SubResource("M6"), SubResource("M7"), SubResource("M8")])
repeats_override = 0
speed = 2.0
