[resource]
script = ExtResource("1_plan")
title = "Armour baseline"
question = "THE BEFORE MEASUREMENT FOR ARMOUR, taken while no armour rule exists, so every hit lands at full value. Once the helper is in Enemy.apply_damage there is no way back to these numbers except by reverting — which is why this is run first. The two figures that matter are DAMAGE DEALT PER RUN and AVERAGE TIME; those are what the multipliers will move.

Matchups 1-3 are the ladder: the same four Ancient Rifle troopers against LIGHT (rover), MEDIUM (walker) and UNARMOURED (each other). 3 is a control and armour must NOT change it — if it moves, the rule has leaked onto things with no armour class. Six repeats on these three because one rover killing four troopers is close to a coin flip at low n.

4-5 vary the damage TYPE against one hull: explosive (Lobber) and small arms (MG Rover) into the same Walker, so the multiplier table can be read off the difference rather than guessed.

6-7 are the counter, and they are a PROXY. There is no anti-armour weapon any AI robot can carry: the Recoilless Rifle is usable_by_ai = false with no ai_scene, and the autocannon is whitelisted to walker and rover. The lab's weapon_swaps ignores that whitelist, so these two put an autocannon in a trooper's hands to measure the damage-type interaction. 7 exists because anti-armour is deliberately WORSE into unarmoured (0.80) and that cost should be visible.

8-9 are how the game is actually played — a walker, a rover and two troopers as one force, mirrored, and then against numbers. The walker may well be overtuned here; that is worth knowing rather than avoiding."
matchups = Array[Resource]([SubResource("M1_ROVER"), SubResource("M2_WALKER"), SubResource("M3_CONTROL"), SubResource("M4_EXPLOSIVE"), SubResource("M5_MGROVER"), SubResource("M6_AT_WALKER"), SubResource("M7_AT_SOFT"), SubResource("M8_MIRROR"), SubResource("M9_NUMBERS")])
repeats_override = 0
speed = 6.0
