}

[sub_resource type="Resource" id="M3"]
script = ExtResource("2_match")
label = "10 rifles vs 2 Bulwarks at 20 m — a fight you can watch"
allies = Array[ExtResource("3_chassis")]([ExtResource("5_soldier"), ExtResource("5_soldier"), ExtResource("5_soldier"), ExtResource("5_soldier"), ExtResource("5_soldier"), ExtResource("5_soldier"), ExtResource("5_soldier"), ExtResource("5_soldier"), ExtResource("5_soldier"), ExtResource("5_soldier")])
ally_order = 1
