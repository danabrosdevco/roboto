[ext_resource type="Resource" uid="uid://daikhvrvnhg7g" path="res://Campaign/chassis/chassis_walker.tres" id="6_walker"]

[sub_resource type="Resource" id="M1"]
script = ExtResource("2_match")
label = "5 rifles vs 2 Bulwarks"
allies = Array[ExtResource("3_chassis")]([ExtResource("5_soldier"), ExtResource("5_soldier"), ExtResource("5_soldier"), ExtResource("5_soldier"), ExtResource("5_soldier")])
ally_order = 1
hostiles = Array[ExtResource("3_chassis")]([ExtResource("4_bulwark"), ExtResource("4_bulwark")])
hostile_order = 1
distance = 45.0
repeats = 3
time_limit = 150.0
swap_sides = false
hostiles_on_post = false
weapon_swaps = {
&"soldier": &"m4"
}

