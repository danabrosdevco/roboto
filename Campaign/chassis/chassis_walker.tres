[resource]
script = ExtResource("1_chassisdef")
id = &"walker"
display_name = "Walker"
description = "Two mounts on one traverse: a main gun that fights, and a coax that answers whatever gets close while the main one reloads. IT ARRIVES HALF-ARMED — the coax mount is empty until you buy something for it. It WALKS, so unlike a rover it takes kit built for legs: a Walker can carry a Nanite Reboot and stand itself back up. Get around the side faster than the turret and both guns are pointing the wrong way."
scene = ExtResource("2_scene")
