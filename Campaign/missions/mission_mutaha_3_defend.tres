[resource]
script = ExtResource("1_missdef")
id = &"mutaha_3_defend"
display_name = "Qamareen — Hold"
briefing = "QAMAREEN, YOURS, AND ALL FOUR ROADS MOVING AT ONCE.

South over the bridge you came in on. West off the plain. East up the lanes. North down the river road, which is also the way out, so the way out is the first thing they take.

They are not spread evenly and they never will be: every column after the first two turns for the COMPUTE HALL. That is the prize on this map and they priced it the same way you did. The clock tower and the fairground will each get their own fight, but the island is where this is decided.

Five bridges hold the middle, and five bridges is five places a column has to come through one at a time. Your garrison is on the avenue, the two mid-town posts and the north island. Use the water.

There is no extraction and nothing to carry home: what you are fighting for is the ground you already own, and everything it pays you."
level_scene = ExtResource("3_map")
map_position = Vector2(0, 0)
enemy_force = Array[ExtResource("2_espec")]([SubResource("A_south"), SubResource("A_west"), SubResource("A_east"), SubResource("A_north"), SubResource("A_westmid"), SubResource("A_eastmid"), SubResource("A_fair"), SubResource("A_clock")])
replace_level_enemies = true
active_objectives = Array[StringName]([&"mutaha_relay_clock", &"mutaha_relay_compute", &"mutaha_relay_fair"])
reward_resources = 0
compute_reward = 0
unlocks = Array[StringName]([])
squad_size = -1
repeatable = true
defence = true
sim = false
garrison_posts = Array[StringName]([&"obj_mutaha_avenue", &"obj_mutaha_w_mid", &"obj_mutaha_e_mid", &"obj_mutaha_isle_north", &"obj_mutaha_listen"])
requires = Array[StringName]([&"mutaha_2_city"])
