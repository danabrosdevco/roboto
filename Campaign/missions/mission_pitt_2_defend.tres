[resource]
script = ExtResource("1_missdef")
id = &"pitt_2_defend"
display_name = "Three Rivers — Hold"
briefing = "Six roads in and five relays over a kilometre of river, and this is the one site where they do not have to choose an axis.

Upstream on the Ohio for the dam. Up the south bank for the shore post. Out of the south hills for the Strip. Off the Monongahela bluff for the furnace. The plateau road for the port, behind all of it. Then the east road, late, with armour on it, straight up the middle at the Strip again — because by then they will know which relay you have been standing on.

You cannot hold five things a kilometre apart. Your garrison is on the island, the bridgehead, the point, the Ohio bank and the coke works, which is one squad per valley and no reserve. This is the hub: every other site on the frontier is reachable from here, which is why they want it and why you are going to be doing this again.

There is no extraction and nothing to carry home: what you are fighting for is the ground you already own, and everything it pays you."
level_scene = ExtResource("3_pitt")
map_position = Vector2(430, 0)
enemy_force = Array[ExtResource("2_espec")]([SubResource("A_nw"), SubResource("A_shore"), SubResource("A_south"), SubResource("A_mon"), SubResource("A_ne"), SubResource("A_east"), SubResource("A_late")])
replace_level_enemies = true
active_objectives = Array[StringName]([&"pitt_relay_dam", &"pitt_relay_shore", &"pitt_relay_strip", &"pitt_relay_furnace", &"pitt_relay_port"])
reward_resources = 0
compute_reward = 0
unlocks = Array[StringName]([])
squad_size = -1
repeatable = true
defence = true
sim = false
garrison_posts = Array[StringName]([&"obj_pitt_island", &"obj_pitt_bridge", &"obj_pitt_point", &"obj_pitt_ohio", &"obj_pitt_coke"])
requires = Array[StringName]([&"pitt_1_rivers"])
