[resource]
script = ExtResource("16_2daps")
id = &"salient_1_overthetop"
display_name = "Over The Top"
briefing = "The salient has been held for nine weeks and shelled for six. Four lines, dug in depth, with the tubes that have been ranging on us sat behind the last of them.

There is no flank. The ground is nine hundred metres wide and every metre of it is observed. You will go up the middle, you will take the lines in order, and you will do it with whatever you still have when you get there.

Bring everything."
level_scene = ExtResource("15_quphb")
map_position = Vector2(0.62, 0.38)
enemy_force = Array[ExtResource("1_343be")]([SubResource("Resource_y1gxg"), SubResource("Resource_e2phv"), SubResource("Resource_qub8j"), SubResource("Resource_yh47q"), SubResource("Resource_eu662"), SubResource("Resource_mbayb"), SubResource("Resource_5vs4a"), SubResource("Resource_56c8l"), SubResource("Resource_oi6l8"), SubResource("Resource_l52ae"), SubResource("Resource_6qn84"), SubResource("Resource_hvbxk"), SubResource("Resource_y0e1x"), SubResource("Resource_827uc"), SubResource("Resource_wq8cf"), SubResource("Resource_t73j1"), SubResource("Resource_jp4ra"), SubResource("Resource_sdv71"), SubResource("Resource_p5obb"), SubResource("Resource_7icoc"), SubResource("Resource_bs3rm"), SubResource("Resource_ugnsv"), SubResource("Resource_gvhxv"), SubResource("Resource_67sxi"), SubResource("Resource_r5n7y"), SubResource("Resource_joq3u"), SubResource("Resource_8jatt"), SubResource("Resource_irv4x"), SubResource("Resource_u84ld")])
replace_level_enemies = true
active_objectives = Array[StringName]([&"sal_first_line", &"sal_support", &"sal_guns", &"sal_back", &"sal_extract"])
reward_resources = 900
compute_reward = 4
unlocks = Array[StringName]([])
squad_size = -1
repeatable = true
