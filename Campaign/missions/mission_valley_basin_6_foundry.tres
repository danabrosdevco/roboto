[resource]
script = ExtResource("1_missdef")
id = &"valley_basin_6_foundry"
display_name = "Valley Foundry (Basin)"
briefing = "They are building in the valley now. Two hives sit inside the compounds and hatch a chaser or a leaper every few seconds once the shooting starts, and there are repair crews behind their line. Only the north gate has to fall — but they will come out to meet you, in column, with armour â and the moment their picket stops answering, two bombers come looking."
level_scene = ExtResource("3_valley")
map_position = Vector2(300, 8)
enemy_force = Array[ExtResource("2_espec")]([SubResource("S_patrol"), SubResource("S_g1"), SubResource("S_g2"), SubResource("S_nest_2"), SubResource("S_g3"), SubResource("S_nest_4"), SubResource("S_g4"), SubResource("S_g5"), SubResource("S_wave_kills_1"), SubResource("S_wave_kills_2"), SubResource("S_wave_nest"), SubResource("S_wave_cap"), SubResource("S_wave_hunters")])
replace_level_enemies = true
active_objectives = Array[StringName]([&"valley_garrison_cap_3", &"valley_hive_south", &"valley_hive_north", &"valley_extract"])
reward_resources = 400
compute_reward = 1
unlocks = Array[StringName]([])
squad_size = -1
repeatable = false
requires = Array[StringName]([&"valley_basin_5_siege"])
