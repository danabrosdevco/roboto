[resource]
script = ExtResource("1_missdef")
id = &"basin_2_defend"
display_name = "Valley Basin — Hold"
briefing = "They want the anchor back. Three columns are already moving on the basin: one up the west pass, two along the north and south rims. Your garrison is dug in at the trenches, the tower and the deck — it will not be enough on its own. Hold the anchor until they stop coming. There is no extraction and nothing to carry home: what you are fighting for is the ground you already own, and everything it pays you."
level_scene = ExtResource("3_basin")
map_position = Vector2(140, -10)
enemy_force = Array[ExtResource("2_espec")]([SubResource("A_pass"), SubResource("A_north"), SubResource("A_south"), SubResource("A_second"), SubResource("A_flank")])
replace_level_enemies = true
active_objectives = Array[StringName]([&"basin_anchor", &"valley_garrison_cap_1", &"valley_garrison_cap_2", &"valley_garrison_cap_3"])
reward_resources = 0
compute_reward = 0
unlocks = Array[StringName]([])
squad_size = -1
repeatable = true
defence = true
sim = false
garrison_posts = Array[StringName]([&"obj_basin_anchor", &"obj_valley_garrison_1", &"obj_valley_garrison_2", &"obj_valley_garrison_4"])
requires = Array[StringName]([&"basin_1_anchor"])
