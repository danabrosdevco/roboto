[resource]
script = ExtResource("1_missdef")
id = &"salient_2_defend"
display_name = "Trenchline — Hold"
briefing = "THE LADDER, BACKWARDS.

Four lines at sixty, a hundred and ninety, three hundred and thirty and four hundred and twenty metres, and you own all four of them. They are coming to break them in the other order, and they do not have to do it all at once — a salient is a thing with enemy on three sides of it, and that is what you are standing in.

Out of the west, over the old jump-off, straight at the forward relay: that is the fight you expect and the one they want you watching. The railhead in the north and the church in the south-east are the ones that matter. They are behind your lines before they start, and they go for the battery and the support relay — which is to say they go for the middle of the ladder and cut it, so the forward line is holding ground that nothing can reach.

There is no flank. Nine hundred metres wide and every metre observed, which was the problem on the way in and is the problem now from the other side. Your garrison is on the three relays and watching the north out of the redoubt and the OP tower.

Three hundred and sixty-five of resistance: the hardest site on the board, and twelve columns of it. Give ground one line at a time. There is no extraction and nothing to carry home: what you are fighting for is the ground you already own, and everything it pays you."
level_scene = ExtResource("3_map")
map_position = Vector2(0.62, 0.38)
enemy_force = Array[ExtResource("2_espec")]([SubResource("A_west"), SubResource("A_rail"), SubResource("A_village"), SubResource("A_church"), SubResource("A_west2"), SubResource("A_rail2"), SubResource("A_village2"), SubResource("A_church2"), SubResource("A_west3"), SubResource("A_rail3"), SubResource("A_village3"), SubResource("A_last")])
replace_level_enemies = true
active_objectives = Array[StringName]([&"sal_relay_front", &"sal_relay_support", &"sal_relay_guns", &"sal_relay_back"])
reward_resources = 0
compute_reward = 0
unlocks = Array[StringName]([])
squad_size = -1
repeatable = true
defence = true
sim = false
garrison_posts = Array[StringName]([&"obj_salient_front", &"obj_salient_support", &"obj_salient_guns", &"obj_salient_redoubt", &"obj_salient_op_tower"])
requires = Array[StringName]([&"salient_1_overthetop"])
