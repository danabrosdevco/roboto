[resource]
script = ExtResource("1_missdef")
id = &"hfw_2_defend"
display_name = "Hillfort — Hold"
briefing = "THEY ARE COMING BACK UP THE HILL, and this time the three lanes are working against you.

You hold the fort and the cores on all three approaches. They do not have to pick a lane the way you did — they are coming up the centre, the west and the east at once, and the cross-wall that kept you out of the east is now a wall you are standing behind with your back to it.

HOLD ANY ONE POINT AND THE SITE IS STILL YOURS. They have to take all of it, which on a hill with six cores and a rampart is a great deal of ground to cover. Watch the pressure readout — their supply is finite and when it is spent and the hill is clear, you have held.

The way down is behind the dish if it goes badly."
level_scene = ExtResource("3_map")
map_position = Vector2(0, -95)
enemy_force = Array[ExtResource("2_espec")]([SubResource("D_centre"), SubResource("D_west"), SubResource("D_east"), SubResource("D_yard")])
replace_level_enemies = true
active_objectives = Array[StringName]([&"hfw_cistern", &"hfw_shoulder", &"hfw_pillars", &"hfw_gatehouse", &"hfw_terrace", &"hfw_relay"])
reward_resources = 0
compute_reward = 0
unlocks = Array[StringName]([])
squad_size = -1
repeatable = true
defence = true
sim = false
garrison_posts = Array[StringName]([&"obj_hfw_dish", &"obj_hfw_yard", &"obj_hfw_centre_apron", &"obj_hfw_west_apron", &"obj_hfw_east_apron"])
requires = Array[StringName]([&"hfw_1_fort"])
