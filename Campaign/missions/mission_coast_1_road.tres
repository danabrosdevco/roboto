[resource]
script = ExtResource("1_missdef")
id = &"coast_1_road"
display_name = "Coast Road"
briefing = "The coast road east, and everything dug in along it. Land in the flats, take the relays at the bridge, the crater field and the town, and get out at the east end. Four hives, armour at every relay, repair crews behind their line. Each relay you take calls something in: bombers for the bridge, armour for the craters, and everything they have left for the town."
level_scene = ExtResource("3_coast")
map_position = Vector2(360, 30)
enemy_force = Array[ExtResource("2_espec")]([SubResource("S_drift"), SubResource("S_surf"), SubResource("S_ridge"), SubResource("S_ford"), SubResource("S_bridge"), SubResource("S_hive_bridge"), SubResource("S_crater"), SubResource("S_hive_crater"), SubResource("S_centre"), SubResource("S_hill"), SubResource("S_hive_hill"), SubResource("S_town_w"), SubResource("S_town"), SubResource("S_hive_town"), SubResource("S_town_e"), SubResource("S_gate"), SubResource("S_kites"), SubResource("S_counter"), SubResource("S_flood"), SubResource("S_surge"), SubResource("S_swarm"), SubResource("S_vultures"), SubResource("S_last")])
replace_level_enemies = true
active_objectives = Array[StringName]([&"coast_relay_bridge", &"coast_relay_craters", &"coast_relay_town", &"coast_hive_bridge", &"coast_hive_craters", &"coast_hive_hill", &"coast_hive_town", &"coast_extract"])
reward_resources = 500
compute_reward = 1
unlocks = Array[StringName]([])
squad_size = -1
repeatable = false
requires = Array[StringName]([&"valley_6_foundry"])
