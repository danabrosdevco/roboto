[resource]
script = ExtResource("1_missdef")
id = &"mutaha_2_city"
display_name = "Qamareen"
briefing = "QAMAREEN, SECOND PASS.

You come in from the SOUTH. The picket on the bridge is not the fight — it is the doorbell.

Then you choose. WEST is tight: terraced streets, courtyards, marksmen on the roofs and chasers waiting in the alleys for whoever walks past first. EAST is open: yards and long lanes where the rovers see you coming and a mortar track drops on wherever you stop.

Both roads meet at the ISLAND. That is where their weight is — the Server Garden and the Compute Hall, mortars on the avenue behind them, and a mechanic standing things back up as fast as you knock them down. It is the hardest fight on the map and it is in the middle of it, not at the end.

Then the district you did not take, now awake and reinforced, and out by the north road.

They answer. Take a district and a column comes in from the map edge to retake it. Touch the Compute Hall and a bomber lifts. Stay too long and the reserve comes down the north road behind you."
level_scene = ExtResource("3_map")
map_position = Vector2(0, 0)
enemy_force = Array[ExtResource("2_espec")]([SubResource("S_crossw"), SubResource("S_crosse"), SubResource("S_stage"), SubResource("A_picket"), SubResource("A_gate"), SubResource("A_patrol"), SubResource("P_west"), SubResource("P_spine"), SubResource("P_sw"), SubResource("P_fork"), SubResource("P_north"), SubResource("SW_plain"), SubResource("SW_stage"), SubResource("SW_south"), SubResource("SW_est"), SubResource("SW_north"), SubResource("SW_quay"), SubResource("W_gate"), SubResource("W_bridge"), SubResource("W_roofs"), SubResource("W_alley"), SubResource("W_guns"), SubResource("W_clock"), SubResource("W_streets"), SubResource("W_hive"), SubResource("W_north"), SubResource("X_west"), SubResource("B_br04"), SubResource("B_br03"), SubResource("B_br02"), SubResource("I_south"), SubResource("I_docks"), SubResource("I_solar"), SubResource("I_plaza"), SubResource("I_server"), SubResource("I_sroofs"), SubResource("I_compute"), SubResource("I_roofs"), SubResource("I_cstreet"), SubResource("I_hive"), SubResource("I_power"), SubResource("I_avenue"), SubResource("I_listen"), SubResource("I_stagen"), SubResource("I_north"), SubResource("X_isle"), SubResource("X_isle2"), SubResource("X_bomber"), SubResource("X_bombw"), SubResource("X_bombe"), SubResource("E_bridge"), SubResource("E_yard"), SubResource("E_stage"), SubResource("E_lanes"), SubResource("E_roofs"), SubResource("E_guns"), SubResource("E_ambush"), SubResource("E_fair"), SubResource("E_apron"), SubResource("E_hive"), SubResource("E_north"), SubResource("X_east"), SubResource("N_stagew"), SubResource("N_road"), SubResource("N_bridge"), SubResource("X_late")])
replace_level_enemies = false
active_objectives = Array[StringName]([&"mutaha_relay_clock", &"mutaha_relay_compute", &"mutaha_relay_fair", &"mutaha_extract"])
reward_resources = 1000
compute_reward = 3
unlocks = Array[StringName]([&"cluster_launcher", &"drone_pack"])
squad_size = -1
repeatable = false
requires = Array[StringName]([&"pitt_1_rivers"])
