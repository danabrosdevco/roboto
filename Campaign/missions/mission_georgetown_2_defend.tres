[resource]
script = ExtResource("1_missdef")
id = &"georgetown_2_defend"
display_name = "Lockside — Hold"
briefing = "FOUR BENCHES, FIVE RELAYS, AND THIS TIME YOU ARE THE ONE ABOVE THEM.

That is the whole difference and it is worth more than it sounds. Every stair head, every ramped street and every canal crossing on this map is a place where they have to come up at you through a gap you can see the whole of. Fourteen metres of fall in a hundred and fifty, all of it in walls — you spent the attack looking up at it.

They come in on all four edges. Off the waterfront at the bottom for the bandstand. Down the canal bench from the long mill at the west end. Out of the back lane at the top for the street. In from the east along the upper road for the lock, which is the crossing they want because it is the only dry one that is not somebody's bridge.

Then it gets heavier and it keeps coming through the same five crossings. Your garrison is at the pergola, the east stair head, the lock yard, the north row and the mill row — one squad per relay, no reserve.

There is no extraction and nothing to carry home: what you are fighting for is the ground you already own, and everything it pays you."
level_scene = ExtResource("3_map")
map_position = Vector2(0, 0)
enemy_force = Array[ExtResource("2_espec")]([SubResource("A_park"), SubResource("A_mill"), SubResource("A_lane"), SubResource("A_town"), SubResource("A_stack"), SubResource("A_lock"), SubResource("A_street"), SubResource("A_west"), SubResource("A_last")])
replace_level_enemies = true
active_objectives = Array[StringName]([&"gt_relay_park", &"gt_relay_stack", &"gt_relay_lock", &"gt_relay_street", &"gt_relay_mill"])
reward_resources = 0
compute_reward = 0
unlocks = Array[StringName]([])
squad_size = -1
repeatable = true
defence = true
sim = false
garrison_posts = Array[StringName]([&"obj_gt_pergola", &"obj_gt_stair_e_head", &"obj_gt_lock_yard", &"obj_gt_row_n", &"obj_gt_mill_row"])
requires = Array[StringName]([&"georgetown_1_ascent"])
