[resource]
script = ExtResource("1_missdef")
id = &"coast_2_defend"
display_name = "Coast Road — Hold"
briefing = "Seven hundred metres of road and three relays strung along it, and they are coming for all three at once.

The weight is on the east road, because the town relay is the one worth having and the road is the only straight way to it. The crater field gets the flank off the north hills. The bridgehead at the west end gets whatever walks down out of the fords — the far end of your own line, four hundred metres from anywhere you can reinforce it from.

That is the problem with this place and it has always been the problem: it is a line, and a line has two ends. Your garrison is in the town, at the centre, on the hill and at the east approaches. Decide early which relay you are prepared to lose.

There is no extraction and nothing to carry home: what you are fighting for is the ground you already own, and everything it pays you."
level_scene = ExtResource("3_coast")
map_position = Vector2(360, 30)
enemy_force = Array[ExtResource("2_espec")]([SubResource("A_east"), SubResource("A_north"), SubResource("A_ford"), SubResource("A_east2"), SubResource("A_flank"), SubResource("A_last")])
replace_level_enemies = true
active_objectives = Array[StringName]([&"coast_relay_bridge", &"coast_relay_craters", &"coast_relay_town"])
reward_resources = 0
compute_reward = 0
unlocks = Array[StringName]([])
squad_size = -1
repeatable = true
defence = true
sim = false
garrison_posts = Array[StringName]([&"obj_coast_town_w", &"obj_coast_centre", &"obj_coast_hill", &"obj_coast_town_e"])
requires = Array[StringName]([&"coast_1_road"])
