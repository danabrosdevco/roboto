[resource]
script = ExtResource("1_missdef")
id = &"arena_5_proving"
display_name = "Arena: Proving Ground"
briefing = "Everything the valley will throw at you, in one bowl: a dug-in line with rifles, a second post behind it, and a pack of runners and hoppers. Three of your squad go in. Clear it and the whole squad goes to the valley."
