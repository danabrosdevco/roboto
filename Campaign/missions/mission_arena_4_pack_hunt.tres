[resource]
script = ExtResource("1_missdef")
id = &"arena_4_pack_hunt"
display_name = "Arena: Pack Hunt"
briefing = "The first leapers: they clear a wall in one leap and go for whoever is weakest. A pack of them with runners, and a picket dug in behind. Take everyone you can supply — keep them close, and keep the repair tool ready."
