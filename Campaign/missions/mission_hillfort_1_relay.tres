[resource]
script = ExtResource("1_missdef")
id = &"hillfort_1_relay"
display_name = "Hillfort"
briefing = "A relay dish on an iron-age hillfort, a hundred and thirty metres up. You come in on the trail below the cistern, at the foot of it, and there is one way on from there and it is uphill the whole way: the standing stones above the cistern, then the old gate and the terrace under the walls. They hold the high ground the entire climb, and on each flanking hill there is a WATCHER — a mast with a sweeping arm and an amber lamp. It is unarmed. It does not need a gun: while one of them has eyes on you it keeps calling groups down onto your route, one after another, for as long as you stay on its hill. Rounds pass straight through the mast; the only thing on it that can be hurt is the plinth at its foot, so it cannot be answered from below. Somebody has to go up and stand over it.

And they answer. Every position you take off them brings the next one down off a ridge onto the leg you are climbing — the east hill after the cistern, the west hill after the stones, the upland after the gate. You will not get a quiet stretch on this hill; the price of clearing a post is the group that arrives because you cleared it.

The relay is in the fort yard. Take the console and hold it — and be ready, because the moment it goes over they come back through the postern and down off the north spur to take it back. Out is the roof, once it is yours.

Your first fight on open ground instead of a sim floor. Nothing here is armoured; all of it is above you."
level_scene = ExtResource("3_hillfort")
map_position = Vector2(92, 26)
enemy_force = Array[ExtResource("2_espec")]([SubResource("S_cistern"), SubResource("S_saddle"), SubResource("S_pillars"), SubResource("S_westhill"), SubResource("S_easthill"), SubResource("S_gate"), SubResource("S_upland"), SubResource("S_terrace"), SubResource("S_shoulder"), SubResource("S_fortgate"), SubResource("S_yard"), SubResource("S_dish"), SubResource("S_power"), SubResource("S_postern"), SubResource("S_spur"), SubResource("S_eastridge"), SubResource("S_westridge"), SubResource("S_highground"), SubResource("S_west_call_a"), SubResource("S_west_call_b"), SubResource("S_east_call_a"), SubResource("S_east_call_b")])
replace_level_enemies = false
active_objectives = Array[StringName]([&"hillfort_relay", &"hillfort_extract"])
reward_resources = 225
compute_reward = 1
unlocks = Array[StringName]([&"rover", &"machine_gun", &"mine_heavy", &"mine_cluster"])
squad_size = -1
repeatable = false
requires = Array[StringName]([&"arena_5_proving"])
