[resource]
script = ExtResource("1_missdef")
id = &"basin_1_anchor"
display_name = "Valley Basin"
briefing = "The valley basin, and the garrison dug in around the tether anchor. Land at the west pass and break the trench line, with the watchtower covering it from the south. Then the anchor itself: up either ramp to the deck at the foot of the tower, and ten seconds at the console. Taking it brings the north and south trenches down on you, and more of them are waiting at the east pass, where you get out."
level_scene = ExtResource("3_basin")
map_position = Vector2(140, -10)
enemy_force = Array[ExtResource("2_espec")]([SubResource("S_trench_n"), SubResource("S_trench_s"), SubResource("S_tower"), SubResource("S_picket"), SubResource("S_deck_w"), SubResource("S_anchor"), SubResource("S_deck_e"), SubResource("S_exit_n"), SubResource("S_exit_s"), SubResource("S_pass"), SubResource("S_counter_n"), SubResource("S_counter_s"), SubResource("S_pack"), SubResource("S_rearguard")])
replace_level_enemies = true
active_objectives = Array[StringName]([&"basin_anchor", &"basin_extract"])
reward_resources = 500
compute_reward = 1
unlocks = Array[StringName]([&"recoilless", &"bolt"])
squad_size = -1
repeatable = false
requires = Array[StringName]([&"hillfort_1_relay"])
