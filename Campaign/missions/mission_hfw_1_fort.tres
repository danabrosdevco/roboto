[resource]
script = ExtResource("1_missdef")
id = &"hfw_1_fort"
display_name = "Hillfort"
briefing = "A RELAY DISH ON AN IRON-AGE HILLFORT, same as the other one, except that this time you can see the whole thing from where you are standing. The dome in front of you is one broad glacis and the fort is on top of it. Nothing on this hill is too steep to walk up. What decides where you go is WALLS, which are things somebody built, and there are three ways past them.

YOU PICK YOUR LANE AT THE TRAILHEAD AND YOU ARE COMMITTED. Two wall lines run north from the fort's own corners down to the treeline, and they stop twenty metres short of the bottom. Once you are inside one, crossing to another means walking all the way back down.

  CENTRE   a hundred metres, straight up the open glacis, under the wall the
           whole way. The fast one. There is ONE core on it — the Pillars —
           and that is the price of the speed.
  WEST     two hundred and eighty, screened for nearly all of it: four berms,
           the cistern, the shoulder bench. TWO cores. You are only in the
           open for the last thirty metres, at the west gate.
  EAST     shut. A cross-wall runs the full width of the hill with a single
           gatehouse in it, and the gatehouse has a core. TAKE IT AND THE LANE
           OPENS — the terrace and the east gate are behind it, and so is
           their garrison, which has been sitting there the whole time.

THE RELAY IS IN THE FORT YARD and it is the largest core on the site. The dish
over it is sixty-two metres and it is what you have been looking at since you
arrived.

NONE OF THE CORES ARE COMPULSORY. The operation ends at THE WAY DOWN — a tunnel
mouth driven into the back of the north rampart, past the dish — and you can
walk to it having taken one core or all six. The difference is what you are
paid and what you are carrying when the last of them comes out of the postern
at you."
level_scene = ExtResource("3_map")
map_position = Vector2(0, -95)
enemy_force = Array[ExtResource("2_espec")]([SubResource("C_pill"), SubResource("C_gate"), SubResource("C_pat"), SubResource("W_cist"), SubResource("W_shou"), SubResource("W_gate"), SubResource("E_gh"), SubResource("E_terr"), SubResource("E_gate"), SubResource("F_pat"), SubResource("F_dish"), SubResource("F_hall"), SubResource("V1"), SubResource("V2"), SubResource("V3"), SubResource("V4")])
replace_level_enemies = true
active_objectives = Array[StringName]([&"hfw_cistern", &"hfw_shoulder", &"hfw_pillars", &"hfw_gatehouse", &"hfw_terrace", &"hfw_relay"])
reward_resources = 225
compute_reward = 1
unlocks = Array[StringName]([&"rover", &"machine_gun", &"mine_heavy", &"mine_cluster"])
squad_size = -1
repeatable = false
defence = false
sim = false
garrison_posts = Array[StringName]([])
requires = Array[StringName]([&"arena_3_firing_line"])
