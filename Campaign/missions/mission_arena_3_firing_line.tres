[resource]
script = ExtResource("1_missdef")
id = &"arena_3_firing_line"
display_name = "Arena: Firing Line"
briefing = "Four dug in on the floor — two pumps and two rifles out of an old American armoury, and the rifles will reach you long before the pumps do. One runner loose in front of them. From here on everyone you can supply goes in with you: send them forward, or keep them on you."
