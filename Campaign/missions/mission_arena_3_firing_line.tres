[resource]
script = ExtResource("1_missdef")
id = &"arena_3_firing_line"
display_name = "Sim Arena: Take And Hold"
briefing = "An assault, which is every operation you will be sent on: ground is taken by holding it, not by emptying it. Nobody here charges you. The core stands in the middle of the floor, just past the cross-wall, with two rifles dug in around it - work it, wait for the drone, and it is yours. The moment it is, the blockhouse sends somebody to take it back. Hold it. Then push through the blockhouse gateway to the bunker in the bay, where two pumps are sitting on it, take that and go home from there. You do not have to kill all six to do any of it."
level_scene = ExtResource("3_arena")
map_position = Vector2(-170, -40)
enemy_force = Array[ExtResource("2_espec")]([SubResource("S_core"), SubResource("S_keep"), SubResource("S_answer")])
replace_level_enemies = true
active_objectives = Array[StringName]([&"proving_capture", &"proving_bunker", &"proving_extract_bay"])
reward_resources = 0
compute_reward = 0
unlocks = Array[StringName]([&"mechanic", &"overclock_servos", &"hardened_uplink", &"armor_plating", &"emp", &"hatchling"])
squad_size = -1
repeatable = true
defence = false
sim = true
