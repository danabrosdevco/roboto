[resource]
script = ExtResource("1_missdef")
id = &"arena_3_firing_line"
display_name = "Sim Arena: Firing Line"
briefing = "Four of them pushing for the centre — two pumps and two rifles out of an old American armoury, and the rifles will reach you long before the pumps do. One runner out in front, quicker than the rest. The tower in the middle is the only thing that breaks their line down the centre lane, so get to it before they do. From here on everyone you can supply goes in with you: send them forward, or keep them on you."
level_scene = ExtResource("3_arena")
map_position = Vector2(-170, -40)
enemy_force = Array[ExtResource("2_espec")]([SubResource("S_shot"), SubResource("S_melee")])
replace_level_enemies = true
active_objectives = Array[StringName]([&"proving_clear", &"proving_extract"])
reward_resources = 150
compute_reward = 1
unlocks = Array[StringName]([&"mechanic", &"overclock_servos", &"hardened_uplink", &"armor_plating"])
squad_size = -1
repeatable = false
requires = Array[StringName]([&"arena_1_contact"])
