[resource]
script = ExtResource("1_missdef")
id = &"arena_3_firing_line"
display_name = "Sim Arena: Take And Hold"
briefing = "An assault, which is every operation you will be sent on: ground is taken by holding it, not by emptying it. Nobody here charges you. Two rifles are dug in around the core on the bay floor and two pumps are sitting on the bunker behind it, and the gateway out of the enemy blockhouse is the way in. Work the core, wait for the drone, and it is yours - and the moment it is, they will send somebody to take it back. Hold it, take the bunker, and go home from there. You do not have to kill all six to do any of it."
level_scene = ExtResource("3_arena")
map_position = Vector2(-170, -40)
enemy_force = Array[ExtResource("2_espec")]([SubResource("S_core"), SubResource("S_keep"), SubResource("S_answer")])
replace_level_enemies = true
active_objectives = Array[StringName]([&"proving_capture", &"proving_bunker", &"proving_extract_bay"])
reward_resources = 0
compute_reward = 0
unlocks = Array[StringName]([&"mechanic", &"overclock_servos", &"hardened_uplink", &"armor_plating"])
squad_size = -1
repeatable = true
defence = false
sim = true
garrison_posts = Array[StringName]([])
requires = Array[StringName]([&"arena_1_contact"])
