[resource]
script = ExtResource("1_missdef")
id = &"hillfort_2_defend"
display_name = "Hillfort — Hold"
briefing = "They are climbing it again. The relay dish in the fort yard is yours and it is the only thing up here worth taking, so there is nothing to guess about where they are going.

Three columns on the hill. One on the trail you came up yourself, below the cistern. One over the saddle to the south-east. One round the west shoulder, which is the only side of this hill that is not the trail — and that is why it is on the list at all, because one way on makes a queue and not a fight.

Your garrison is in the fort yard, on the gate and down the climb at the terrace and the old gate. It buys you the time to be in the right place; it does not hold the yard for you.

Hold the dish. There is no extraction and nothing to carry home: what you are fighting for is the ground you already own, and everything it pays you."
level_scene = ExtResource("3_hillfort")
map_position = Vector2(92, 26)
enemy_force = Array[ExtResource("2_espec")]([SubResource("A_trail"), SubResource("A_saddle"), SubResource("A_shoulder"), SubResource("A_second")])
replace_level_enemies = true
active_objectives = Array[StringName]([&"hillfort_relay"])
reward_resources = 0
compute_reward = 0
unlocks = Array[StringName]([])
squad_size = -1
repeatable = true
defence = true
sim = false
garrison_posts = Array[StringName]([&"obj_hillfort_yard", &"obj_hillfort_fortgate", &"obj_hillfort_terrace", &"obj_hillfort_gate"])
requires = Array[StringName]([&"hillfort_1_relay"])
