[resource]
script = ExtResource("1_missdef")
id = &"arena_1_contact"
display_name = "Sim Arena: First Contact"
briefing = "Two chassis on the sim arena floor, both carrying pumps, and they will not wait at their end — they come for the middle the moment you are down. They hit hard up close and not much further, so take them across a low wall rather than in the open. Three lanes run the length of the floor: the low walls you can shoot over standing, the tall ones you cannot see past at all."
