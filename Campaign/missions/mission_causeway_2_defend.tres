[resource]
script = ExtResource("1_missdef")
id = &"causeway_2_defend"
display_name = "The Causeway — Hold"
briefing = "TWELVE HUNDRED METRES OF GROUND ON A SITE WITH TWO WAYS IN, AND THEY ARE USING BOTH.

This is the richest thing you own and it is shaped like a corridor. The far bank first: a column off the west terrace for the staging yard, and a second straight out onto the deck behind it. Six hundred metres of open span with a one-metre parapet and nothing else on it at all — you crossed it once under fire and know exactly what it is worth.

In the east they come round the flood channel and up past the sangars, for the checkpoint and then the fort yard. One opening in the curtain wall, which cuts both ways: nothing gets in without coming through your gateway, and nothing you lose outside the walls can be helped from inside them. The gun pits, the mortars and the ammunition dump are all out there.

Then the tower, and the tower is the part to think about now rather than later. Twenty-four halls, one ramp each, and it moves wall to wall — so every floor is entered through a hole in its own floor with you on the far side of the room. They will send infantry up it: the basement, the twelfth, and eventually the crown. A hundred and thirty-eight metres of stairwell with no windows and one door at each end. Nothing comes in and nothing gets out.

Your garrison is on the north-west and south-east bastions, the staging yard, the deck midpoint and the two set-back halls. Everything else is distance.

There is no extraction and nothing to carry home: what you are fighting for is the ground you already own, and everything it pays you."
level_scene = ExtResource("3_map")
map_position = Vector2(0, 0)
enemy_force = Array[ExtResource("2_espec")]([SubResource("A_stage"), SubResource("A_deck"), SubResource("A_check"), SubResource("A_yard"), SubResource("A_ammo"), SubResource("A_base"), SubResource("A_deck2"), SubResource("A_twelfth"), SubResource("A_crown"), SubResource("A_west2"), SubResource("A_last")])
replace_level_enemies = true
active_objectives = Array[StringName]([&"cway_relay_staging", &"cway_relay_crossing", &"cway_relay_checkpoint", &"cway_relay_yard", &"cway_relay_basement", &"cway_relay_twelfth", &"cway_uplink", &"cway_ammo"])
reward_resources = 0
compute_reward = 0
unlocks = Array[StringName]([])
squad_size = -1
repeatable = true
defence = true
sim = false
garrison_posts = Array[StringName]([&"obj_cway_bastion_nw", &"obj_cway_bastion_se", &"obj_cway_staging", &"obj_cway_deck_mid", &"obj_cway_hall_12", &"obj_cway_hall_23"])
requires = Array[StringName]([&"causeway_1_tower"])
