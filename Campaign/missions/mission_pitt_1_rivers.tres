[resource]
script = ExtResource("1_missdef")
id = &"pitt_1_rivers"
display_name = "Three Rivers"
briefing = "Three rivers and a fort on every bend. Land in the south-west hills and come up the rail valley to the Ohio. Four relays hold the valleys: the lock on the Ohio dam, the North Shore command post, the Strip, and the furnace on the Monongahela. Take all four and get out at the east end of the road. Their gunships sit over the ridges and every big garrison calls them in the moment it is hit, so choose where you start each fight. Each relay you take brings that valley's reserve down on you. Three hives, armour in every fort, and more of them the longer it goes."
level_scene = ExtResource("3_pitt")
map_position = Vector2(430, 0)
enemy_force = Array[ExtResource("2_espec")]([SubResource("S_rail"), SubResource("S_ohio"), SubResource("S_dam"), SubResource("S_island"), SubResource("S_hive_island"), SubResource("S_shore"), SubResource("S_point"), SubResource("S_strip"), SubResource("S_bridge"), SubResource("S_hive_bridge"), SubResource("S_port"), SubResource("S_furnace"), SubResource("S_coke"), SubResource("S_hive_coke"), SubResource("S_exit"), SubResource("S_lock"), SubResource("S_shore_res"), SubResource("S_plateau"), SubResource("S_mon"), SubResource("S_swarm"), SubResource("S_column"), SubResource("S_air_dam"), SubResource("S_air_shore"), SubResource("S_air_strip"), SubResource("S_air_furnace")])
replace_level_enemies = true
active_objectives = Array[StringName]([&"pitt_relay_dam", &"pitt_relay_shore", &"pitt_relay_strip", &"pitt_relay_furnace", &"pitt_relay_port", &"pitt_hive_island", &"pitt_hive_bridge", &"pitt_hive_coke", &"pitt_extract"])
reward_resources = 650
compute_reward = 1
unlocks = Array[StringName]([&"cyclic_feed"])
squad_size = -1
repeatable = false
requires = Array[StringName]([&"coast_1_road"])
