[resource]
script = ExtResource("1_missdef")
id = &"polaris_2_defend"
display_name = "Polaris — Hold"
briefing = "THE RING ROAD IS A CLOSED LOOP AND THEY ARE ON ALL OF IT.

You held this court once already, against five waves somebody else counted for you. Nothing is counting this time. They come in off the loop — south across the car park, east round the parking deck, west down the boulevard past the multiplex, north out of the subdivision, which is still the one direction the court has nothing covering.

Three things are yours and all three are in the open: the uplink in the entry court, the multiplex relay on the west flank, the deck relay on the east. The mall is a wall at your back with no way through it. There is no straight on this site longer than a hundred and fifty metres and no corner a vehicle cannot reach.

Your garrison is on the planters, both corrals and both anchor lobes — which is the court and its two shoulders, and nothing at all out in the asphalt. The aisles are cover for whoever is crossing, not for whoever is holding. That was true when you were the one crossing.

There is no extraction and nothing to carry home: what you are fighting for is the ground you already own, and everything it pays you."
level_scene = ExtResource("3_map")
map_position = Vector2(0, 0)
enemy_force = Array[ExtResource("2_espec")]([SubResource("A_south"), SubResource("A_east"), SubResource("A_west"), SubResource("A_north"), SubResource("A_deck"), SubResource("A_blvd"), SubResource("A_sub"), SubResource("A_mplex"), SubResource("A_last")])
replace_level_enemies = true
active_objectives = Array[StringName]([&"pol_breach", &"pol_relay_cinema", &"pol_relay_deck"])
reward_resources = 0
compute_reward = 0
unlocks = Array[StringName]([])
squad_size = -1
repeatable = true
defence = true
sim = false
garrison_posts = Array[StringName]([&"obj_pol_planters", &"obj_pol_corral_w", &"obj_pol_corral_e", &"obj_pol_anchor_w", &"obj_pol_anchor_e"])
requires = Array[StringName]([&"polaris_1_siege"])
