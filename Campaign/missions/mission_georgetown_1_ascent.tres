[resource]
script = ExtResource("1_missdef")
id = &"georgetown_1_ascent"
display_name = "Lockside"
briefing = "LOCKSIDE. YOU COME ASHORE AT THE BOTTOM AND THE OPERATION IS UPHILL ALL OF IT.

The town steps down to the river in four flat terraces, each held up by a stone wall, and the only ways between them are the public stairs, two ramped streets and the canal crossings. Fourteen metres of fall in about a hundred and fifty, every metre of it in a wall you can see — so you always know what is above you, and so does everything on it.

You land at the WEST END OF THE PARK, on the lowest terrace. The waterfront is a derelict park now rather than an esplanade: paths that go round instead of through, overgrown beds, a tennis court, a pergola and a bandstand. The relay is under the bandstand roof. It is the easiest of the four and it is the one that tells them you are here.

Up the stairs onto the LOWER YARDS — the old industrial terrace, warehouses and mills and a works compound, with a forty-four metre chimney standing over it that you can see from every level of this map. The second relay is at the foot of it, in the open, with a stair head either side of you and a viaduct at each end of the bench looking down the length of it.

Then THE CANAL, which is the spine. Nine metres wide, three metres deep, vertical stone both sides, and it runs the whole width of the map. There are FIVE ways over it — two footbridges, a street bridge, a plank, and the lock gates — and they are all held. Pick one. The lock is the third relay and the only dry crossing that is not somebody's bridge; there is a mechanic in the lock yard who will stand their armour back up as fast as you knock it down.

Last, the TOWN. Federal rowhouses straight onto the pavement with a stoop, two terraces facing each other across one street — the tightest ground on the map, and the only ground on it where nothing is above you. Fourteen seconds at the relay in the middle of that street. Then out the east end on the upper road, which is the far corner of the map from where you came ashore.

THEY ANSWER EVERY RELAY. Take the park and a column comes down to the stair heads. Take the stack and a walker comes off the top terrace. Touch the lock and a bomber lifts. And they count their own losses: three separate columns come in on a body count whatever you have or have not finished.

FOUR OPTIONAL TARGETS, all of them off the climb: the long mill at the far west end of the canal, two hives, and the marksman post under the east viaduct."
level_scene = ExtResource("3_map")
map_position = Vector2(0, 0)
enemy_force = Array[ExtResource("2_espec")]([SubResource("W_tennis"), SubResource("W_band"), SubResource("W_fount"), SubResource("W_play"), SubResource("W_market"), SubResource("W_perg"), SubResource("W_espe"), SubResource("W_patrol"), SubResource("S_wfoot"), SubResource("S_efoot"), SubResource("S_whead"), SubResource("S_ehead"), SubResource("Y_stack"), SubResource("Y_comp"), SubResource("Y_yards"), SubResource("Y_ware"), SubResource("Y_mill"), SubResource("Y_viadw"), SubResource("Y_viade"), SubResource("Y_patrol"), SubResource("Y_hive"), SubResource("Y_ramp"), SubResource("C_trussw"), SubResource("C_road"), SubResource("C_plank"), SubResource("C_trusse"), SubResource("C_lock"), SubResource("C_coffer"), SubResource("C_towpw"), SubResource("C_towpe"), SubResource("C_mill"), SubResource("C_cmark"), SubResource("C_patrol"), SubResource("C_scaff"), SubResource("C_works"), SubResource("C_berm"), SubResource("Y_walker"), SubResource("T_stairw"), SubResource("T_staire"), SubResource("T_ramp"), SubResource("T_street"), SubResource("T_stw"), SubResource("T_ste"), SubResource("T_rown"), SubResource("T_rows"), SubResource("T_rowse"), SubResource("T_tmill"), SubResource("T_hive"), SubResource("T_patrol"), SubResource("T_out"), SubResource("R_parkw"), SubResource("R_parke"), SubResource("R_stacka"), SubResource("R_stackb"), SubResource("R_locka"), SubResource("R_lockb"), SubResource("R_bomber"), SubResource("R_street"), SubResource("R_street2"), SubResource("R_outroad"), SubResource("K_sixty"), SubResource("K_hundred"), SubResource("K_last")])
replace_level_enemies = false
active_objectives = Array[StringName]([&"gt_relay_park", &"gt_relay_stack", &"gt_relay_lock", &"gt_relay_street", &"gt_relay_mill", &"gt_hive_yards", &"gt_hive_town", &"gt_listening", &"gt_extract"])
reward_resources = 1200
compute_reward = 4
unlocks = Array[StringName]([&"repair_kit"])
squad_size = -1
repeatable = false
requires = Array[StringName]([&"mutaha_2_city"])
