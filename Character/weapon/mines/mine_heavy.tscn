[gd_scene load_steps=6 format=3]

; HEAVY MINE — one, placed, and it stays there.
;
; 160 damage in 4.5m kills a rover outright and cripples a walker. mine_lifetime
; 0 means it does not expire: you put it on the approach you are worried about
; and it is still there when they come. That permanence is what you are buying
; with quantity 1.

[ext_resource type="Script" path="res://Character/weapon/mine.gd" id="1_mine"]
[ext_resource type="PackedScene" uid="uid://cvgqcttmucw6e" path="res://Character/weapon/explosion.tscn" id="2_blast"]
[ext_resource type="AudioStream" uid="uid://bojna3iqqu0a5" path="res://sounds/sfx/superior soundfx/Explosion1.wav" id="3_boom"]
[ext_resource type="PackedScene" path="res://Character/weapon/concepts/mine_heavy.tscn" id="4_model"]

[sub_resource type="CylinderShape3D" id="shape"]
radius = 0.28
height = 0.18

[node name="HeavyMine" type="RigidBody3D" node_paths=PackedStringArray("explosion_sfx", "mesh")]
script = ExtResource("1_mine")
explosion_scene = ExtResource("2_blast")
explosion_sfx = NodePath("ExplosionSound")
mesh = NodePath("Body")
blast_damage = 160
blast_radius = 4.5
fuse_time = 99999.0
explode_on_bounce = false
arm_seconds = 1.5
trigger_radius = 2.2
mine_lifetime = 0.0

[node name="Body" parent="." instance=ExtResource("4_model")]

[node name="CollisionShape3D" type="CollisionShape3D" parent="."]
shape = SubResource("shape")

[node name="ExplosionSound" type="AudioStreamPlayer3D" parent="."]
stream = ExtResource("3_boom")

[connection signal="body_entered" from="." to="." method="_on_body_entered"]
