[gd_scene load_steps=6 format=3]

; CLUSTER MINE — thrown, bursts on landing, scatters five submines over ~6m.
;
; This is cluster_shell.gd doing the job it was already written for: the
; Cluster Launcher's shell throws six timed bomblets, and this throws five
; PROXIMITY MINES instead. The only difference is what submunition_scene points
; at, which is exactly why that export exists.
;
; Its own burst is small (20) because the canister is a delivery system, not a
; grenade — what makes it worth a slot is the ground it owns afterwards.
;
; ClusterShell sets explode_on_bounce = false on everything it scatters, which
; a mine needs anyway, and Mine._ready() asserts it a second time rather than
; trusting the caller.

[ext_resource type="Script" path="res://Character/weapon/cluster_shell.gd" id="1_shell"]
[ext_resource type="PackedScene" uid="uid://cvgqcttmucw6e" path="res://Character/weapon/explosion.tscn" id="2_blast"]
[ext_resource type="PackedScene" path="res://Character/weapon/mines/mine_cluster_submine.tscn" id="3_submine"]
[ext_resource type="AudioStream" uid="uid://bojna3iqqu0a5" path="res://sounds/sfx/superior soundfx/Explosion1.wav" id="4_boom"]

[sub_resource type="SphereShape3D" id="shape"]
radius = 0.14

[node name="ClusterMineCanister" type="RigidBody3D" node_paths=PackedStringArray("explosion_sfx", "mesh")]
script = ExtResource("1_shell")
explosion_scene = ExtResource("2_blast")
explosion_sfx = NodePath("ExplosionSound")
mesh = NodePath("Body")
blast_damage = 20
fuse_time = 6.0
explode_on_bounce = true
bounce_before_explode = 0
submunition_scene = ExtResource("3_submine")
submunitions = 5
scatter_speed = 3.6
scatter_lift = 2.4
submunition_fuse_min = 45.0
submunition_fuse_max = 45.0
submunition_damage = 45
submunition_radius = 2.0

[node name="Body" type="Node3D" parent="."]

[node name="CollisionShape3D" type="CollisionShape3D" parent="."]
shape = SubResource("shape")

[node name="ExplosionSound" type="AudioStreamPlayer3D" parent="."]
stream = ExtResource("4_boom")

[connection signal="body_entered" from="." to="." method="_on_body_entered"]
