[gd_scene load_steps=7 format=3]

; CLUSTER SUBMINE — one of five thrown out by the canister.
;
; 45 damage in 2m: enough that walking into one hurts, not enough to be a
; Heavy Mine you get five of.
;
; mine_lifetime 0 means IT STAYS FOR THE MISSION. It used to clear itself after
; 45 seconds, on the reasoning that area denial which never expires is a map you
; cannot use any more — but that is only true of a mine you can walk into, and
; Mine._candidates is faction-gated, so your own squad and the player never can.
; What the timer actually did was make the item a 45-second window you had to
; spend at exactly the right moment, which is not a thing you can aim.
;

[ext_resource type="Script" path="res://Character/weapon/mine.gd" id="1_mine"]
[ext_resource type="PackedScene" uid="uid://cvgqcttmucw6e" path="res://Character/weapon/explosion.tscn" id="2_blast"]
[ext_resource type="AudioStream" uid="uid://bojna3iqqu0a5" path="res://sounds/sfx/superior soundfx/Explosion1.wav" id="3_boom"]
[ext_resource type="PackedScene" path="res://Character/weapon/models/caltrop_mine_model.tscn" id="4_model"]

[sub_resource type="PhysicsMaterial" id="grippy"]
friction = 1.0
rough = true
bounce = 0.0

[sub_resource type="SphereShape3D" id="shape"]
radius = 0.075

[node name="ClusterSubmine" type="RigidBody3D" node_paths=PackedStringArray("explosion_sfx", "mesh")]
script = ExtResource("1_mine")
explosion_scene = ExtResource("2_blast")
explosion_sfx = NodePath("ExplosionSound")
mesh = NodePath("Body")
blast_damage = 45
blast_radius = 2.0
fuse_time = 99999.0
explode_on_bounce = false
arm_seconds = 1.0
trigger_radius = 1.6
mine_lifetime = 0.0
settle_speed = 0.7
settle_after = 3.0
physics_material_override = SubResource("grippy")
linear_damp = 0.6
angular_damp = 2.5

[node name="Body" parent="." instance=ExtResource("4_model")]

[node name="CollisionShape3D" type="CollisionShape3D" parent="."]
shape = SubResource("shape")

[node name="ExplosionSound" type="AudioStreamPlayer3D" parent="."]
stream = ExtResource("3_boom")

[connection signal="body_entered" from="." to="." method="_on_body_entered"]
