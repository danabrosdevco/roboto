[gd_scene load_steps=4 format=3]

; DRONE CARRIER PACK, in the player's hands. Thrown, like the Hatchling.
;
; HELD FURTHER OUT THAN A GRENADE, AND STRIPPED TO THE CANISTER. The depth was
; inherited from grenade_hud_weapon, which is sized for a frag that fits in a
; fist; this case is 0.34m across and filled the middle of the screen at that
; distance. The two harness straps are the only parts that are not the canister
; itself — they stand 0.15m proud, taller than the 0.14m case they are strapped
; to, and read as webbing hanging in front of the view. Hidden here rather than
; in the model, which is also the thrown canister and the armoury icon.

[ext_resource type="PackedScene" path="res://Character/weapon/grenade_hud_weapon.tscn" id="1_base"]
[ext_resource type="PackedScene" path="res://Character/weapon/drone_pack/drone_pack_canister.tscn" id="2_proj"]
[ext_resource type="PackedScene" path="res://Character/weapon/models/drone_pack_model.tscn" id="3_model"]

