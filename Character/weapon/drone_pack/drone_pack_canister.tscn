[gd_scene load_steps=4 format=3]

; THE PACK IN FLIGHT. A grenade whose "explosion" is two Divers.
;
; Inherits ai_grenade_projectile.tscn exactly as the Hatchling Canister does,
; so it gets impact fusing, contact monitoring, continuous collision and
; level-scoped parenting without a line of new code.

[ext_resource type="PackedScene" path="res://Character/characters/ai/equipment/ai_grenade_projectile.tscn" id="1_base"]
[ext_resource type="PackedScene" path="res://Character/weapon/drone_pack/drone_pack_payload.tscn" id="2_payload"]
[ext_resource type="PackedScene" path="res://Character/weapon/models/drone_pack_model.tscn" id="3_model"]

[node name="Drone_Pack_Canister" node_paths=PackedStringArray("mesh") instance=ExtResource("1_base")]
explosion_scene = ExtResource("2_payload")
explode_on_bounce = true
bounce_before_explode = 0
mesh = NodePath("Pack")

[node name="Frag_West" parent="."]
visible = false

[node name="ExplosionSound" parent="."]
pitch_scale = 1.4
volume_db = -9.0

[node name="Pack" parent="." instance=ExtResource("3_model")]
transform = Transform3D(1.4, 0, 0, 0, 1.4, 0, 0, 0, 1.4, 0, 0, 0)
