[gd_scene load_steps=5 format=3]

; CLUSTER LAUNCHER on an AI mount.
;
; AIWeaponGrenadeLauncher with lob_speed set, which is the ground-launched arc
; — it solves the low trajectory onto the target rather than dropping from
; altitude like the bomber. impact_fused so the shell bursts where it lands
; instead of rolling on, and salvo 1 because one round already produces six
; explosions.
;
; min_effective_range 14 is not flavour. A round that arcs comes down steeply
; and the bomblets scatter five metres; an ally firing this at something in its
; own face kills itself and whoever is next to it. Below fourteen metres it
; holds and lets the rifles work.

[ext_resource type="Script" path="res://Character/weapon/ai_weapon_grenade_launcher.gd" id="1_aigl"]
[ext_resource type="PackedScene" path="res://Character/weapon/cluster_shell.tscn" id="2_shell"]
[ext_resource type="PackedScene" path="res://Character/weapon/models/cluster_launcher_model.tscn" id="3_model"]
[ext_resource type="AudioStream" uid="uid://3ps2c3e6sglw" path="res://sounds/sfx/grenade launcher/freesound_community-grenade-launcher-106342.mp3" id="4_fire"]

[node name="ai_weapon_cluster" type="Node3D" node_paths=PackedStringArray("muzzle_origin", "shot_audio")]
