extends SceneTree

# ─────────────────────────────────────────────
# THE BOARD ON THE REAL TABLE.
#
# Everything so far has been shot with the projection floating in mid-air at
# whatever size suited the harness. TERRAIN has since built the furniture —
# a 7.0 x 3.0 m operations table in the ops car, with an OpsTableAnchor at
# the centre of its top surface and an Interactible already on it.
#
# This loads the real art scene, finds that anchor, hangs the board off it
# and photographs the result. It is the only way to find out whether the
# board is the right size for the table it now has to live on, and the
# answer is not something to guess at: the plate was square until a moment
# ago and would have hung half a metre off both long sides.
#
# THE LEVEL, not the art. maps/railhead_level.tscn instances the art and does
# the gameplay wiring — the spawn onto PlayerArrival, the behaviour onto the
# ops table anchor. If this shot works, the base works.
#
#   godot --audio-driver Dummy --path . --script res://tools/shot_railhead_table.gd -- <out dir>
# ─────────────────────────────────────────────

const ART := "res://maps/railhead_level.tscn"
const TABLE := "res://Env/world_objects/ops_table.gd"
const ANCHOR := "OpsTableAnchor"

var _cam: Camera3D = null


func _init() -> void:
	var args := OS.get_cmdline_user_args()
	var out_dir: String = String(args[0]) if args.size() > 0 else "res://docs/marketing/wip"
	DirAccess.make_dir_recursive_absolute(out_dir)

	Settings.path = "user://settings_probe.json"
	await process_frame
	var world: Node = load("res://Env/world.tscn").instantiate()
	world.get_node("CampaignManager").autosave = false
	root.add_child(world)
	for _i in 100:
		await physics_frame
	for who in PauseHold.holders():
		PauseHold.release(who)

	var level: Node = world.player.get_parent()
	var art: Node = load(ART).instantiate()
	level.add_child(art)
	print("  level loaded: %s" % art.name)
	for _i in 60:
		await physics_frame

	var anchor := _find(art, ANCHOR) as Node3D
	if anchor == null:
		print("")
		print("  no %s in %s — has tools/fit_ops_table.gd been run?" % [ANCHOR, ART])
		quit(1)
		return
	print("")
	print("  anchor found at %s" % str(anchor.global_position))

	var inter = _find_interactible(anchor)
	print("  its Interactible: %s" % ("yes" if inter != null else "NO — F will not work"))

	# The behaviour goes on in the LEVEL, not in the car scene. The car is
	# regenerated by TERRAIN's builder and anything added there is wiped;
	# the anchor and its name are the contract, and this is the gameplay
	# side of it.
	# The LEVEL wires this now, so just find what it made.
	var table = null
	for c in anchor.get_children():
		if c.get_script() == load(TABLE):
			table = c
	if table == null:
		print("  the level did NOT fit an OpsTable to the anchor")
		quit(1)
		return
	print("  the level fitted an OpsTable to the anchor")
	for _i in 40:
		await physics_frame

	var board = table.get("board")
	if board != null:
		print("  board %.1f m long, plate %.1f x %.1f m, icons %.2f m" % [
			board.board_size, board.plate_size.x, board.plate_size.y, board.icon_height])
	print("  sites drawn: %d" % table.facts.size())

	# ── the rest of the base ────────────────────
	var lvl := art
	var sp = lvl.get("spawn_point")
	print("  spawn_point   %s" % (str(sp.global_position) if sp != null else "MISSING — World._ready would crash"))
	var ms = lvl.get("muster")
	print("  SquadMuster   %s  callsign=%s" % [str(ms.global_position) if ms != null else "MISSING", str(ms.callsign) if ms != null else "-"])
	var dx = lvl.get("departure")
	print("  departure pad %s  is_departure=%s" % [str(dx.global_position) if dx != null else "MISSING", str(dx.is_departure) if dx != null else "-"])
	print("  in group levelexit: %s" % str(dx != null and dx.is_in_group("levelexit")))
	var env = null
	for c in lvl.get_children():
		if c is WorldEnvironment or c.get_node_or_null("WorldEnvironment") != null:
			env = c
	print("  WorldEnvironment: %s" % ("yes" if env != null else "MISSING"))

	# A camera at the marker TERRAIN left for exactly this, if it is there.
	_cam = Camera3D.new()
	root.add_child(_cam)
	_cam.current = true
	var view := _find(art, "HoloTable_ViewA") as Node3D
	var look: Vector3 = anchor.global_position + Vector3(0.0, 0.1, 0.0)
	if view != null:
		print("  using TERRAIN's HoloTable_ViewA marker for the camera")
		_cam.global_position = view.global_position + Vector3(0.0, 1.55, 0.0)
	else:
		_cam.global_position = anchor.global_position + Vector3(0.0, 1.5, 3.2)
	_cam.look_at(look, Vector3.UP)
	for _i in 20:
		await physics_frame
	await _grab("%s/rail_01_table.png" % out_dir, "the board on TERRAIN's table")

	# Along the car, the way you would walk up to it.
	_cam.global_position = anchor.global_position + Vector3(-4.6, 1.35, 0.0)
	_cam.look_at(anchor.global_position, Vector3.UP)
	for _i in 20:
		await physics_frame
	await _grab("%s/rail_02_along.png" % out_dir, "down the length of the car")

	# ── a destination committed to ──────────────
	# THE STANDING VIEW IS THE TEST. The queued landmark is blown up and lit so
	# that the board answers "where am I going" from where a player actually
	# stands, not under inspection — so it is photographed from the same marker
	# as rail_01, before and after, and the pair is the only honest comparison.
	var campaign = root.get_tree().get_first_node_in_group(&"campaign")
	var board_table = _find(lvl, "OpsTable")
	if campaign == null or board_table == null:
		print("  no campaign or no table, so the queued treatment is not photographed")
	else:
		var options: Array = campaign.available_missions()
		if options.is_empty():
			print("  nothing available to queue")
		else:
			if view != null:
				_cam.global_position = view.global_position + Vector3(0.0, 1.55, 0.0)
			_cam.look_at(look, Vector3.UP)
			campaign.select_mission(options[0].id)
			board_table.refresh()
			# Long enough for the grow tween to finish and settle.
			for _i in 60:
				await process_frame
			await _grab("%s/rail_03_queued.png" % out_dir,
				"'%s' queued, from the standing view" % options[0].display_name)
			# And closer, to judge the glow and the ring against the landmark.
			_cam.global_position = anchor.global_position + Vector3(0.0, 1.1, 2.4)
			_cam.look_at(anchor.global_position, Vector3.UP)
			for _i in 20:
				await physics_frame
			await _grab("%s/rail_04_queued_close.png" % out_dir, "the designation, close")

	print("")
	quit(0)


func _find(n: Node, named: String) -> Node:
	if n.name == named:
		return n
	for c in n.get_children():
		var f := _find(c, named)
		if f != null:
			return f
	return null


func _find_interactible(n: Node):
	for c in n.get_children():
		if c is Interactible:
			return c
		var f = _find_interactible(c)
		if f != null:
			return f
	return null


func _grab(path: String, note: String) -> void:
	await RenderingServer.frame_post_draw
	var img := get_root().get_texture().get_image()
	var err := img.save_png(path)
	if err == OK:
		print("    %-22s  %s" % [path.get_file(), note])
	else:
		printerr("    could not write %s (%s)" % [path, error_string(err)])
